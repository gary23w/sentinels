#!/bin/sh
# What apk runs once garrett is removed (not after an upgrade). The one firewall table garrett owns goes with it.
if command -v nft >/dev/null 2>&1; then nft delete table inet garrett 2>/dev/null || true; fi
# So does what it kept, as with the bundle's install.sh --remove: its cases, its enrolment credential, and the
# configuration file that may hold an enrolment key.
rm -rf /var/lib/garrett /etc/garrett
exit 0
