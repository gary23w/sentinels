<?xml version="1.0" encoding="utf-8"?>
<!-- garrett, the Sentinel agent, for Chocolatey. packaging/package-managers.py fills in the version and the
     Windows Installer package's SHA-256 for a release; choco pack makes the package from the result. -->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>garrett</id>
    <version>@VERSION@</version>
    <packageSourceUrl>https://github.com/gary23w/sentinels/tree/main/packaging/chocolatey</packageSourceUrl>
    <owners>sentinels</owners>
    <title>garrett (sentinels agent)</title>
    <authors>sentinels contributors</authors>
    <projectUrl>https://garrettstimpson.ca/</projectUrl>
    <licenseUrl>https://github.com/gary23w/sentinels/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <projectSourceUrl>https://github.com/gary23w/sentinels</projectSourceUrl>
    <docsUrl>https://gary23w.github.io/sentinels/manual.html</docsUrl>
    <bugTrackerUrl>https://github.com/gary23w/sentinels/issues</bugTrackerUrl>
    <tags>sentinels garrett security intrusion-detection agent</tags>
    <summary>The agent of sentinels: a host intrusion sentinel that stops what it catches.</summary>
    <description>garrett, the agent of sentinels, watches this machine's running programs and their connections, scores them on the machine, and pauses or ends a program it judges hostile.

It reports cases to a Sentinel service you run yourself, applies what that service learned from earlier attacks, and shares what one machine learns with the rest of your machines.

It runs as SYSTEM and starts with Windows. See what it finds with "C:\Program Files\garrett\garrett.cmd" cases. The manual: https://gary23w.github.io/sentinels/manual.html</description>
    <releaseNotes>https://github.com/gary23w/sentinels/releases/tag/v@VERSION@</releaseNotes>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
